// Qonic Consulting — internal platform schema.
//
// Design note: roles are ROWS, not an enum, so new roles ("Legal", "Marketing")
// are created through the admin UI with no migration and no deploy. Application
// code branches on PERMISSIONS, never on role keys — see lib/auth/permissions.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Identity --

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  jobTitle     String?
  employeeCode String?    @unique
  /// Link to an externally hosted avatar. Nothing is uploaded or stored by this
  /// application — see ROADMAP for the "everything on the fly" decision.
  photoUrl     String?
  status       UserStatus @default(ACTIVE)

  // --- HR record (Phase 3) ---
  dateOfBirth       DateTime?
  joinedOn          DateTime?
  leftOn            DateTime?
  address           String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  /// Self-relation driving the org chart and the leave approval chain.
  managerId String?
  manager   User?   @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("ReportsTo")

  clientsOwned                     Client[]                     @relation("ClientOwner")
  candidatesAdded                  Candidate[]                  @relation("CandidateAddedBy")
  remindersSent                    Reminder[]                   @relation("ReminderSender")
  jobsOwned                        Job[]                        @relation("JobOwner")
  applicationsOwned                Application[]                @relation("ApplicationOwner")
  interviews                       Interview[]                  @relation("Interviewer")
  placements                       Placement[]                  @relation("PlacementRecruiter")
  paymentsRecorded                 Payment[]                    @relation("PaymentRecorder")
  expenses                         Expense[]                    @relation("ExpenseOwner")
  expenseDecisions                 Expense[]                    @relation("ExpenseApprover")
  notifications                    Notification[]               @relation("NotificationRecipient")
  bankDetail                       BankDetail?
  linkedCandidate                  Candidate?                   @relation("CandidateLink")
  projectsManaged                  Project[]                    @relation("ProjectManager")
  projectAssignments               ProjectAssignment[]
  timesheets                       Timesheet[]                  @relation("TimesheetOwner")
  timesheetDecisions               Timesheet[]                  @relation("TimesheetApprover")
  payoutsReceived                  PayoutLedgerEntry[]          @relation("PayoutRecipient")
  compensationProfiles             CompensationProfile[]        @relation("CompensationRecipient")
  compensationSet                  CompensationProfile[]        @relation("CompensationSetter")
  earningInvoices                  EarningInvoice[]             @relation("EarningInvoicePayee")
  earningInvoiceDecisions          EarningInvoice[]             @relation("EarningInvoiceDecider")
  earningInvoicePayments           EarningInvoice[]             @relation("EarningInvoicePayer")
  earningInvoiceEarlyReleases      EarningInvoiceEarlyRelease[] @relation("EarningInvoiceEarlyReleasePayee")
  earningInvoiceEarlyReleaseGrants EarningInvoiceEarlyRelease[] @relation("EarningInvoiceEarlyReleaseGranter")
  leaveRequests                    LeaveRequest[]               @relation("LeaveRequester")
  leaveDecisions                   LeaveRequest[]               @relation("LeaveDecider")
  leaveBalances                    LeaveBalance[]
  resetTokens                      PasswordResetToken[]
  mustChangePassword               Boolean                      @default(false)
  techStack                        String?
  lastLoginAt                      DateTime?
  failedLoginCount                 Int                          @default(0)
  lockedUntil                      DateTime?

  // --- Two-factor authentication (Phase 8) ---
  /// Base32 TOTP secret, encrypted at rest. Null until enrolment starts.
  totpSecretEnc    String?
  /// Only true once a code has been verified — a half-finished enrolment
  /// must never lock someone out.
  totpEnabled      Boolean @default(false)
  /// Hashed single-use recovery codes, newline separated.
  totpBackupHashes String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  sessions  Session[]
  overrides UserPermissionOverride[]
  auditLogs AuditLog[]               @relation("AuditActor")

  contractsAuthored ContractLetter[] @relation("ContractAuthor")
  contractsSubject  ContractLetter[] @relation("ContractSubject")
  contractsReleased ContractLetter[] @relation("ContractReleaser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
  @@index([managerId])
}

/// Single-use, short-lived. Only the hash is stored, exactly as with sessions.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String @id @default(cuid())
  /// sha256 of the cookie value. The raw token is never stored, so a database
  /// leak yields no usable sessions.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress         String?
  userAgent         String?
  /// Idle expiry, rolled forward on use.
  expiresAt         DateTime
  /// Hard cap. Never extended, so a stolen session cannot live forever.
  absoluteExpiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// -------------------------------------------------------------------- RBAC --

model Role {
  id               String  @id @default(cuid())
  /// Stable identifier referenced from code (lib/auth/roles.ts). Never renamed.
  key              String  @unique
  label            String
  description      String?
  /// True for the CEO row only. Grants an unconditional allow-all bypass, so the
  /// CEO can never lock themselves out by mis-toggling their own permissions.
  isSuperAdmin     Boolean @default(false)
  /// System roles cannot be deleted or have their key changed.
  isSystem         Boolean @default(false)
  /// True for the Developer row only. Accounts in it originate in the Candidate
  /// Pool — add the candidate there, then create their employee account — rather
  /// than in Administration → People. POST /api/admin/users and the role change
  /// on PATCH /api/admin/users/[id] both refuse such a role, so an account in it
  /// always has a candidate record behind it, and People leaves it out of the
  /// role dropdown entirely.
  ///
  /// SEED-OWNED, not a per-role switch. It was briefly settable when creating a
  /// role, and a custom role created with it ticked both vanished from People
  /// and became what "Create Employee Account" handed out. The seed now clears
  /// it from anything that is not a `viaCandidatePool` entry in SEEDED_ROLES.
  viaCandidatePool Boolean @default(false)
  /// Lower = more senior. Drives the privilege-escalation guard: you may only
  /// administer users whose rank is strictly greater than your own.
  rank             Int     @default(100)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  /// Dotted key, e.g. "contract.release". Seeded from the code-owned catalog.
  key         String  @unique
  /// Groups the admin console's toggle matrix into sections.
  group       String
  label       String
  description String?
  sortOrder   Int     @default(0)

  roles     RolePermission[]
  overrides UserPermissionOverride[]
}

/// The CEO's toggle. `enabled` is what the admin console flips per role.
model RolePermission {
  roleId       String
  permissionId String
  enabled      Boolean @default(false)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  updatedAt   DateTime @updatedAt
  updatedById String?

  @@id([roleId, permissionId])
}

enum OverrideEffect {
  ALLOW
  DENY
}

/// Per-user exception to the role default. DENY beats ALLOW; both are ignored
/// once `expiresAt` has passed, which makes temporary elevation self-cleaning.
model UserPermissionOverride {
  userId       String
  permissionId String
  effect       OverrideEffect
  reason       String?
  expiresAt    DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  createdById String?

  @@id([userId, permissionId])
}

// -------------------------------------------------------- Contract letters --

enum ContractStatus {
  DRAFT
  PENDING_RELEASE
  CHANGES_REQUESTED
  RELEASED
  ACKNOWLEDGED
  REVOKED
}

model ContractLetter {
  id        String @id @default(cuid())
  reference String @unique

  subjectUserId String
  subject       User   @relation("ContractSubject", fields: [subjectUserId], references: [id])
  authorUserId  String
  author        User   @relation("ContractAuthor", fields: [authorUserId], references: [id])

  status      ContractStatus @default(DRAFT)
  /// Versioned template id. A change to an issued letter's wording must ship as
  /// a NEW key (…-v2), never as an edit to an existing one — documents are
  /// rendered on demand, so editing v1 would retroactively alter issued letters.
  templateKey String         @default("standard-employment-v1")
  /// The frozen source of truth. Editing is blocked once the letter leaves
  /// DRAFT/CHANGES_REQUESTED, so this snapshot is what every future render uses.
  payload     Json
  version     Int            @default(1)

  releasedAt   DateTime?
  releasedById String?
  releasedBy   User?     @relation("ContractReleaser", fields: [releasedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?
  revokedById  String?

  events ContractLetterEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectUserId, status])
  @@index([status])
}

/// Append-only. Written in the same transaction as the status change, so the
/// approval trail can never drift from the letter's actual state.
model ContractLetterEvent {
  id         String          @id @default(cuid())
  letterId   String
  letter     ContractLetter  @relation(fields: [letterId], references: [id], onDelete: Cascade)
  fromStatus ContractStatus?
  toStatus   ContractStatus
  actorId    String
  note       String?
  createdAt  DateTime        @default(now())

  @@index([letterId, createdAt])
}

// ------------------------------------------------------------------ Audit ---

model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ------------------------------------------------------------------- Leave --

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Configurable leave types, so a new category needs no migration.
model LeaveType {
  id            String  @id @default(cuid())
  key           String  @unique
  label         String
  description   String?
  /// Days granted per employee per year. 0 means unlimited/unaccrued (e.g. unpaid).
  annualDays    Int     @default(0)
  /// Whether a balance is tracked and decremented on approval.
  tracksBalance Boolean @default(true)
  colour        String  @default("#0e9384")
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  requests LeaveRequest[]
  balances LeaveBalance[]
}

/// One row per employee, leave type, and year.
model LeaveBalance {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year         Int
  /// Days granted for the year, which may be adjusted per person.
  entitledDays Float     @default(0)
  /// Days consumed by APPROVED requests. Maintained transactionally with the
  /// request itself so the two can never disagree.
  usedDays     Float     @default(0)

  @@unique([userId, leaveTypeId, year])
  @@index([userId, year])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  /// Working days requested, computed at submission and frozen thereafter.
  days        Float
  reason      String?
  status      LeaveStatus @default(PENDING)

  decidedById  String?
  decidedBy    User?     @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
  @@index([startDate])
}

// ------------------------------------------------------------- Delivery ----

enum ClientStatus {
  ACTIVE
  UPCOMING
  RESCHEDULED
  CANCELLED
  PROSPECT
  DORMANT
  ARCHIVED
}

model Client {
  id       String       @id @default(cuid())
  name     String       @unique
  code     String       @unique
  status   ClientStatus @default(ACTIVE)
  industry String?
  website  String?
  notes    String?

  /// The person who owns the commercial relationship.
  ownerId String?
  owner   User?   @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// The vendor that procured and/or manages this job. Kept as a relation so a
  /// vendor's contact details are maintained once and reused for every job.
  vendorId          String?
  vendor            Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// The Global Candidate whose profile was marketed for this job.
  globalCandidateId String?
  globalCandidate   Candidate? @relation("ClientGlobalCandidate", fields: [globalCandidateId], references: [id], onDelete: SetNull)

  employmentType                   String?
  workArrangement                  String?
  startDate                        DateTime? @db.Date
  endDate                          DateTime? @db.Date
  /// Actual rate received by the vendor, in minor units per hour. This is the
  /// authoritative commercial rate for C2C billing; Project.defaultRate is
  /// only retained for legacy/non-C2C projects.
  actualClientRate                 Int?
  rateCurrency                     String    @default("USD")
  /// Per-job snapshots. They are seeded from CommissionPolicy when the client
  /// is created, then remain stable if the policy changes later.
  globalCandidateCommissionPercent Float?
  vendorCommissionPercent          Float?

  contacts  ClientContact[]
  projects  Project[]
  jobs      Job[]
  invoices  Invoice[]
  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([vendorId])
  @@index([globalCandidateId])
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  ARCHIVED
}

/// A vendor is a reusable business contact, never a string copied onto each
/// client/job. `name` is the legal/company name used on commercial documents.
model Vendor {
  id          String       @id @default(cuid())
  name        String       @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  website     String?
  status      VendorStatus @default(ACTIVE)
  notes       String?

  clients   Client[]
  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// One logical policy row, created by the migration. It is intentionally
/// separate from Client so the default can be changed without hard-coding a
/// percentage in forms, routes, invoices, or reports.
model CommissionPolicy {
  id                                      String   @id @default("default")
  defaultGlobalCandidateCommissionPercent Float    @default(20)
  defaultVendorCommissionPercent          Float    @default(20)
  updatedAt                               DateTime @updatedAt
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  title     String?
  isPrimary Boolean @default(false)

  @@index([clientId])
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  PLANNED
  ON_HOLD
  CANCELLED
}

enum BillingModel {
  TIME_AND_MATERIALS
  FIXED_PRICE
  RETAINER
  NON_BILLABLE
}

model Project {
  id       String        @id @default(cuid())
  code     String        @unique
  name     String
  clientId String
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status   ProjectStatus @default(ACTIVE)
  health   ProjectHealth @default(ON_TRACK)
  billing  BillingModel  @default(TIME_AND_MATERIALS)

  /// Minor units (paise/cents) to avoid floating-point money.
  budgetAmount   Int?
  budgetCurrency String @default("INR")
  /// Charge-out rate in minor units per hour.
  defaultRate    Int?

  negotiationCompleted Boolean @default(false)
  completedReason      String?

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  notes     String?

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  assignments  ProjectAssignment[]
  tasks        ProjectTask[]
  timeEntries  TimeEntry[]
  milestones   ProjectMilestone[]
  invoices     Invoice[]
  expenses     Expense[]
  payoutLedger PayoutLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([status])
  @@index([managerId])
}

/// Who may book time to a project, and at what rate.
model ProjectAssignment {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Per-person override of Project.defaultRate, read when an invoice is built
  /// from approved time (app/api/invoices/route.ts).
  ///
  /// NO LONGER SETTABLE: Rate Management was the only screen that wrote it. Rows
  /// that already carry a value are still honoured — which is why the column
  /// stays — but new assignments fall through to Project.defaultRate, which the
  /// project form does still set.
  rate              Int?
  /// Planned share of a working week. Shown on Projects, My Work, and the
  /// Candidate Pool; set when someone is assigned to a project.
  allocationPercent Int       @default(100)
  /// The day this person actually began working on this project — distinct from
  /// `createdAt` (just when this row was inserted) and from `Project.startDate`
  /// (the project's own date, not any one person's). Read when a timesheet is
  /// approved, to split actual payout from backfilled days.
  ///
  /// NO LONGER SETTABLE, for the same reason as `rate` above. Existing values
  /// are still honoured; otherwise callers fall back to `createdAt`.
  startedOn         DateTime? @db.Date

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectTask {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  /// Non-billable tasks never contribute to invoiceable hours.
  billable  Boolean @default(true)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  timeEntries TimeEntry[]

  @@index([projectId])
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// A week of time for one person, and the unit that gets approved and locked.
model Timesheet {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation("TimesheetOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// Monday of the week, in UTC.
  weekStart DateTime        @db.Date
  status    TimesheetStatus @default(DRAFT)

  submittedAt  DateTime?
  decidedById  String?
  decidedBy    User?     @relation("TimesheetApprover", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  entries      TimeEntry[]
  payoutLedger PayoutLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([status])
  @@index([weekStart])
}

model TimeEntry {
  id          String       @id @default(cuid())
  timesheetId String
  timesheet   Timesheet    @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  taskId      String?
  task        ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  workDate DateTime @db.Date
  /// Stored as MINUTES. Hours as a float would accumulate rounding error across
  /// a month of entries and make invoices disagree with timesheets.
  minutes  Int
  /// Snapshot of the task's billable flag at entry time, so later changes to the
  /// task cannot silently re-bill approved work.
  billable Boolean  @default(true)
  note     String?

  /// Stamped when the hours are pulled onto an invoice. This is what stops the
  /// same time being billed twice.
  invoicedAt DateTime?
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timesheetId])
  @@index([projectId, workDate])
  @@index([workDate])
  @@index([invoiceId])
}

// -------------------------------------------------- Payout ledger & deals --
//
// A separate ledger from Invoice/Payment: those bill the CLIENT, this tracks
// what a resource is owed. The two are related (both driven by approved,
// billable time) but deliberately not the same model — an invoice line is a
// claim on the client, a payout ledger row is a claim from the resource, and
// conflating them would make "backfilled days billed to the client but not
// paid to the resource" impossible to represent cleanly.

enum PayoutCategory {
  /// workDate >= this resource's own assignment start.
  ACTUAL_PAYOUT
  /// workDate before their own start but on/after Project.startDate — a
  /// backfilled day, billed to the client but not (by default) paid out.
  BILLED_TO_COMPANY
}

/// One row per (person, project, day) that was ever approved with billable
/// time — the payout equivalent of an invoice line. Generated automatically
/// when a timesheet is approved (app/api/timesheets/[id]/decision/route.ts),
/// never entered by hand except through the override fields below.
model PayoutLedgerEntry {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("PayoutRecipient", fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  workDate DateTime       @db.Date
  /// Minor units — the day's rate frozen at approval time, so a later rate
  /// change never rewrites already-earned history (same reasoning as
  /// Placement.feeAmount).
  amount   Int
  currency String         @default("INR")
  category PayoutCategory

  createdAt DateTime @default(now())

  @@unique([userId, projectId, workDate])
  @@index([userId, workDate])
  @@index([projectId])
}

// ------------------------------------------------- Company compensation --
//
// Client invoices are receivables. These models deliberately represent the
// other side of the ledger: the monthly amount a Qonic person may invoice the
// company for, and the invoice they submit to receive it. Keeping them apart
// stops payroll from ever appearing as client revenue.

model CompensationProfile {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("CompensationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  /// Minor units per calendar month. A new row, rather than an UPDATE, records
  /// every salary decision and keeps past earning invoices reproducible.
  monthlyAmount Int
  currency      String    @default("INR")
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  setById       String?
  setBy         User?     @relation("CompensationSetter", fields: [setById], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime  @default(now())

  @@unique([userId, effectiveFrom])
  @@index([userId, effectiveFrom, effectiveTo])
}

enum EarningInvoiceSource {
  /// Developer's approved, payout-eligible delivery ledger entries.
  DELIVERY_PAYOUT
  /// Salary schedule set by the CEO or Co-Founder for a People account.
  MONTHLY_SALARY
}

enum EarningInvoiceStatus {
  SUBMITTED
  APPROVED
  PAID
  REJECTED
  VOID
}

/// A payable invoice raised by a Qonic portal user to Qonic Systems.
model EarningInvoice {
  id               String                      @id @default(cuid())
  reference        String                      @unique
  userId           String
  user             User                        @relation("EarningInvoicePayee", fields: [userId], references: [id], onDelete: Cascade)
  /// First day of the invoice month, e.g. 2026-08-01.
  period           DateTime                    @db.Date
  currency         String
  amount           Int
  source           EarningInvoiceSource
  /// A month normally has one invoice. An urgent, founder-authorised Developer
  /// invoice may be followed by a closed-month supplemental invoice for the
  /// approved delivery earned after the early release.
  sequence         Int                         @default(1)
  status           EarningInvoiceStatus        @default(SUBMITTED)
  /// A frozen calculation: profile date slices or delivery-ledger totals.
  calculation      Json
  notes            String?
  submittedAt      DateTime                    @default(now())
  decidedAt        DateTime?
  decidedById      String?
  decidedBy        User?                       @relation("EarningInvoiceDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionNote     String?
  paidAt           DateTime?
  paidById         String?
  paidBy           User?                       @relation("EarningInvoicePayer", fields: [paidById], references: [id], onDelete: SetNull)
  paymentReference String?
  earlyReleaseId   String?
  earlyRelease     EarningInvoiceEarlyRelease? @relation(fields: [earlyReleaseId], references: [id], onDelete: SetNull)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([userId, period, currency, sequence])
  @@index([status, period])
  @@index([userId, period])
  @@index([earlyReleaseId])
}

/// A deliberately narrow, auditable exception to the calendar-month close
/// rule. It enables one person and one currency for the current open month;
/// it never opens invoice raising globally or for future months.
model EarningInvoiceEarlyRelease {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("EarningInvoiceEarlyReleasePayee", fields: [userId], references: [id], onDelete: Cascade)
  /// First day of the current open month.
  period      DateTime         @db.Date
  currency    String
  reason      String
  grantedById String
  grantedBy   User             @relation("EarningInvoiceEarlyReleaseGranter", fields: [grantedById], references: [id], onDelete: Restrict)
  grantedAt   DateTime         @default(now())
  /// Set atomically when the person raises their early invoice. A Developer's
  /// later approved days become a supplemental closed-month invoice instead.
  usedAt      DateTime?
  invoices    EarningInvoice[]

  @@unique([userId, period, currency])
  @@index([period, usedAt])
  @@index([grantedById])
}

// -------------------------------------------- Phase 4 completion: delivery --

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  dueDate     DateTime        @db.Date
  status      MilestoneStatus @default(PENDING)
  /// Fixed-price projects bill on milestones; minor units.
  amount      Int?
  completedAt DateTime?
  notes       String?
  sortOrder   Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

// ------------------------------------------------- Phase 5: recruitment ----

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  FILLED
  CLOSED
}

model Job {
  id        String    @id @default(cuid())
  reference String    @unique
  title     String
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status    JobStatus @default(DRAFT)

  description    String?
  location       String?
  employmentType String  @default("Full-time")
  openings       Int     @default(1)
  /// Minor units. The salary band advertised to candidates.
  salaryMin      Int?
  salaryMax      Int?
  currency       String  @default("INR")
  /// Placement fee as a percentage of first-year salary.
  feePercent     Float?
  /// Target days to fill, used to flag ageing requisitions.
  slaDays        Int?
  /// Shown on the public careers page.
  isPublished    Boolean @default(false)

  ownerId String?
  owner   User?   @relation("JobOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isPublished])
  @@index([clientId])
}

/// Whether a candidate is still in play. Deactivating archives them rather than
/// deleting: the record, its name, and its pipeline history all stay intact.
enum CandidateStatus {
  ACTIVE
  ARCHIVED
}

enum CandidateKind {
  GLOBAL
  DEVELOPER
  DIRECT
}

enum CandidateConsentStatus {
  NOT_REQUIRED
  PENDING
  CONSENTED
  DECLINED
}

model Candidate {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  phone          String?
  ssn            String?
  visaType       String?
  visaStatus     String?
  visaExpiry     DateTime?
  address        String?
  commissionPaid Int?
  techStack      String?
  benchStatus    String?       @default("Available / On Bench")
  /// A LINK to an externally hosted CV. Nothing is uploaded or stored here.
  resumeUrl      String?
  linkedinUrl    String?
  location       String?
  headline       String?
  /// Comma-separated for now; a tag table is a later refinement.
  skills         String?
  source         String        @default("Direct")
  /// Explicit classification avoids inferring a Global Candidate from a free
  /// text source. Legacy records are backfilled by the migration.
  kind           CandidateKind @default(DIRECT)
  /// Minor units.
  currentSalary  Int?
  expectedSalary Int?
  noticePeriod   String?
  notes          String?

  /// Recorded when the candidate agreed to us holding their data.
  consentAt     DateTime?
  consentStatus CandidateConsentStatus @default(NOT_REQUIRED)

  /// The authenticated user who added this record. This is system-populated;
  /// it is not an editable field on the candidate form.
  addedById String?
  addedBy   User?   @relation("CandidateAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  /// ARCHIVED candidates keep their real name and history — nothing is scrubbed.
  status     CandidateStatus @default(ACTIVE)
  archivedAt DateTime?

  applications      Application[]
  consents          CandidateConsent[]
  globalAgreements  GlobalCandidateAgreement[]
  marketingProfiles CandidateMarketingProfile[]
  clientJobs        Client[]                    @relation("ClientGlobalCandidate")

  /// Set only at the one deliberate moment a candidate becomes a real
  /// employee — "Create Employee Account" in the Candidate Pool
  /// (POST /api/candidates/[id]/employee). Never written by a background job:
  /// this used to be guessed live by matching email strings between Candidate
  /// and User, which had no audit trail and could silently archive the wrong
  /// account. `onDelete: SetNull` because purging a User must never be blocked
  /// by, or cascade into, this candidate's history — see the ARCHIVED comment
  /// above.
  linkedUserId String? @unique
  linkedUser   User?   @relation("CandidateLink", fields: [linkedUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([benchStatus])
  @@index([status])
  @@index([kind, consentStatus])
  @@index([addedById])
}

/// Append-only consent requests/responses. The raw token is never stored; a
/// candidate's affirmative response is both visible on Candidate and preserved
/// here as a historical record.
model CandidateConsent {
  id          String                 @id @default(cuid())
  candidateId String
  candidate   Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      CandidateConsentStatus @default(PENDING)
  tokenHash   String                 @unique
  requestedAt DateTime               @default(now())
  respondedAt DateTime?
  ipAddress   String?

  @@index([candidateId, requestedAt])
}

/// Global Candidates are external profiles, never staff portal users. Their
/// master representation agreement is separately addressed to their email and
/// acknowledged through a one-time public link.
enum GlobalCandidateAgreementStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  DECLINED
  REVOKED
}

model GlobalCandidateAgreement {
  id                       String                         @id @default(cuid())
  reference                String                         @unique
  candidateId              String
  candidate                Candidate                      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recipientEmail           String
  status                   GlobalCandidateAgreementStatus @default(DRAFT)
  /// Versioned document payload. It freezes the candidate profile and the
  /// commercial wording actually sent, while sensitive identifiers stay out.
  payload                  Json
  authorUserId             String
  releasedById             String?
  releasedAt               DateTime?
  acknowledgementTokenHash String?                        @unique
  /// One-time acceptance links deliberately expire. The generated PDF remains
  /// available to authorised staff, but an old emailed link cannot be used to
  /// create a fresh acknowledgement months later.
  acknowledgementExpiresAt DateTime?
  acknowledgedAt           DateTime?
  responseIp               String?
  revokedAt                DateTime?
  revokedById              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId, status])
  @@index([status, releasedAt])
}

/// A Global Candidate can be marketed through multiple technology profiles
/// without duplicating the candidate or their consent/documents.
model CandidateMarketingProfile {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  technology  String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([candidateId, technology])
  @@index([technology, isActive])
}

/// The pipeline stages an application moves through.
enum ApplicationStage {
  SOURCED
  SCREENED
  SUBMITTED
  INTERVIEW
  OFFER
  PLACED
  REJECTED
  WITHDRAWN
}

model Application {
  id          String           @id @default(cuid())
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage       ApplicationStage @default(SOURCED)

  ownerId String?
  owner   User?   @relation("ApplicationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Free-text reason captured when an application is rejected or withdrawn.
  outcomeReason String?
  /// Came in through the public careers form rather than being sourced.
  isInbound     Boolean @default(false)

  events     ApplicationEvent[]
  interviews Interview[]
  placement  Placement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One application per candidate per job — re-applying reuses the row.
  @@unique([jobId, candidateId])
  @@index([stage])
  @@index([jobId, stage])
}

/// Append-only stage history, written with the transition itself.
model ApplicationEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     ApplicationStage?
  toStage       ApplicationStage
  actorId       String?
  note          String?
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt])
}

enum InterviewOutcome {
  PENDING
  ADVANCE
  REJECT
  NO_SHOW
}

model Interview {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  durationMins  Int         @default(60)
  /// "Phone screen", "Technical", "Client panel"…
  kind          String      @default("Screening")
  location      String?

  interviewerId String?
  interviewer   User?   @relation("Interviewer", fields: [interviewerId], references: [id], onDelete: SetNull)

  /// 1–5. Null until feedback is recorded.
  score    Int?
  outcome  InterviewOutcome @default(PENDING)
  feedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([scheduledAt])
}

model Placement {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  startDate  DateTime @db.Date
  /// Minor units.
  salary     Int
  currency   String   @default("INR")
  /// Percentage of salary charged to the client.
  feePercent Float
  /// Denormalised at placement time so a later fee-policy change cannot
  /// retroactively alter historic revenue.
  feeAmount  Int

  /// The recruiter credited with the placement.
  recruiterId String?
  recruiter   User?   @relation("PlacementRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)

  /// Guarantee period; a fall-out inside it usually voids the fee.
  guaranteeDays Int?
  fellOutAt     DateTime?

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recruiterId])
}

// ------------------------------------------------------ Phase 6: finance ---

enum InvoiceStatus {
  DRAFT
  SENT
  PART_PAID
  PAID
  OVERDUE
  VOID
}

enum CommercialInvoiceKind {
  STANDARD
  QONIC_TO_VENDOR
  VENDOR_TO_GLOBAL_CANDIDATE
  GLOBAL_CANDIDATE_COMMISSION_RECORD
}

model Invoice {
  id                String                @id @default(cuid())
  number            String                @unique
  clientId          String
  client            Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId         String?
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status            InvoiceStatus         @default(DRAFT)
  commercialKind    CommercialInvoiceKind @default(STANDARD)
  /// All C2C invoices for a billing period share this ID. It makes the three
  /// documents easy to reconcile while preserving standalone standard invoices.
  commercialGroupId String?
  billingRecipient  String?

  issueDate DateTime @db.Date
  dueDate   DateTime @db.Date
  currency  String   @default("INR")
  /// Null when payment is expected in the invoice currency. For example, a
  /// USD vendor invoice may be contractually settled into Qonic's INR bank
  /// account, while the USD invoice itself remains immutable.
  settlementCurrency  String?
  /// INR (or settlement-currency) units per one invoice-currency unit, frozen
  /// when the invoice is created. It is used only for realised FX reporting.
  lockedSettlementRate Decimal? @db.Decimal(18, 6)

  /// All minor units, computed from the lines and frozen when the invoice is sent.
  subtotal   Int   @default(0)
  taxPercent Float @default(0)
  taxAmount  Int   @default(0)
  total      Int   @default(0)
  paidAmount Int   @default(0)

  /// Frozen reconciliation values for C2C documents. Standard invoices leave
  /// these null; C2C documents always satisfy gross = Qonic + vendor + global.
  grossClientAmount               Int?
  vendorCommissionAmount          Int?
  globalCandidateCommissionAmount Int?
  qonicRevenueAmount              Int?

  notes    String?
  /// Set when issued, so the document can be re-rendered exactly as sent.
  sentAt   DateTime?
  voidedAt DateTime?

  lines       InvoiceLine[]
  payments    Payment[]
  creditNotes CreditNote[]
  placements  Placement[]
  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([status])
  @@index([dueDate])
  @@index([commercialGroupId])
  @@index([commercialKind])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  /// Hundredths of a unit (hours × 100) so 7.5h is exact.
  quantity    Int
  /// Minor units per unit.
  unitRate    Int
  amount      Int
  sortOrder   Int     @default(0)

  @@index([invoiceId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Int
  /// Actual bank receipt, in the settlement currency, when it differs from
  /// the invoice currency. `amount` remains the invoice-currency amount
  /// allocated to reduce the receivable.
  settlementAmount   Int?
  settlementCurrency String?
  /// Actual settlement amount less the locked-rate value of `amount`, in the
  /// settlement currency's minor units. Positive is a realised FX gain.
  realizedFxGainLoss Int?
  paidOn    DateTime @db.Date
  method    String   @default("Bank transfer")
  reference String?
  note      String?

  recordedById String?
  recordedBy   User?   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

model Expense {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ExpenseOwner", fields: [userId], references: [id], onDelete: Cascade)

  spentOn     DateTime @db.Date
  category    String   @default("Other")
  /// Minor units.
  amount      Int
  currency    String   @default("INR")
  description String
  /// A LINK to a receipt hosted elsewhere; nothing is stored here.
  receiptUrl  String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Whether it should be passed on to the client.
  billable  Boolean  @default(false)

  status       ExpenseStatus @default(DRAFT)
  decidedById  String?
  decidedBy    User?         @relation("ExpenseApprover", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  reimbursedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
}

enum ReminderChannel {
  EMAIL
  WHATSAPP
}

/// One immutable row per dispatch. Counts and history are calculated from
/// these records, which prevents a mutable counter from drifting over time.
model Reminder {
  id        String          @id @default(cuid())
  vendorId  String?
  vendor    Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  channel   ReminderChannel
  recipient String
  message   String
  sentById  String?
  sentBy    User?           @relation("ReminderSender", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt    DateTime        @default(now())

  @@index([vendorId, sentAt])
  @@index([clientId, sentAt])
  @@index([recipient, sentAt])
}

// ------------------------------------ Deferred items + Phases 7 and 8 ------

/// Public holidays. Leave day-counting consults these so a holiday inside a
/// requested range is not deducted from someone's allowance.
model Holiday {
  id     String   @id @default(cuid())
  date   DateTime @unique @db.Date
  name   String
  /// Optional region so a multi-country team can diverge later.
  region String   @default("IN")

  createdAt DateTime @default(now())

  @@index([date])
}

enum NotificationKind {
  LEAVE
  TIMESHEET
  CONTRACT
  EXPENSE
  INVOICE
  RECRUITMENT
  SYSTEM
}

/// In-app inbox. Written by the same transaction as the event it describes, so
/// a notification can never reference something that did not happen.
model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  kind   NotificationKind @default(SYSTEM)
  title  String
  body   String?
  /// Where clicking it should take the person.
  link   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

/// Payment details, encrypted at rest with AES-256-GCM (see lib/crypto.ts).
/// Split from User so the ciphertext is not loaded on every session lookup.
model BankDetail {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// All three hold `iv:authTag:ciphertext`, never plaintext.
  accountNameEnc   String
  accountNumberEnc String
  sortCodeEnc      String
  /// Safe to show in a list without decrypting anything.
  lastFour         String
  bankName         String?

  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// A credit note against an invoice — the correct instrument once a payment
/// exists and voiding is no longer allowed.
model CreditNote {
  id         String   @id @default(cuid())
  number     String   @unique
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  /// Minor units. Never exceeds the invoice total.
  amount     Int
  reason     String
  issuedAt   DateTime @default(now())
  issuedById String?

  @@index([invoiceId])
}

// ---------------------------------------------------------- Abuse controls --

/// A fixed-window counter for per-IP throttling of the public endpoints.
///
/// Postgres rather than Redis on purpose: the app already depends on this
/// database, and adding a second datastore for a handful of counters would buy
/// atomicity we can get from a unique index anyway. One row per (key, window),
/// swept by lib/rate-limit.ts as it goes, so the table stays small.
model RateLimit {
  id          String   @id @default(cuid())
  /// "<bucket>:<client ip>", e.g. "login:203.0.113.7".
  key         String
  /// Start of the fixed window this row counts. Part of the unique key, so a
  /// new window inserts a new row instead of racing an update.
  windowStart DateTime
  count       Int      @default(0)

  @@unique([key, windowStart])
  @@index([windowStart])
}
