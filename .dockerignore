# Build artifacts and deps — reinstalled/rebuilt inside the image.
node_modules
.next
lib/generated

# Secrets and local env — never bake these into an image.
.env
.env.*
!.env.example

# Local tooling, tests, and docs not needed at runtime.
.git
.gitignore
tests
test-results
playwright-report
*.md
docs
.vscode
.idea
.DS_Store

# The Docker build/config files themselves (but NOT docker/docker-entrypoint.sh,
# which the image copies and runs). .dockerignore stays at the repo root because
# it must sit at the build-context root.
.dockerignore
docker/Dockerfile
docker/docker-compose.yml
docker/docker-compose.local.yml
