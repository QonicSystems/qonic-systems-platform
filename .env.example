# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Database (Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5432/qonic_dev
# Used only by the integration/e2e suites. Must be a DISPOSABLE database.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/qonic_test

# --- First-run bootstrap ---
# The seed creates the CEO account ONLY when the user table is empty.
# Password must be at least 12 characters; the account is forced to change it on first login.
BOOTSTRAP_CEO_EMAIL=founder@qonicsystems.com
BOOTSTRAP_CEO_NAME=Avinash Singh
BOOTSTRAP_CEO_PASSWORD=change-this-long-password

# --- SMTP: used by POST /api/contact and password reset ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
CONTACT_TO_EMAIL=hello@qonicsystems.com
CONTACT_FROM_EMAIL=website@qonicsystems.com

# --- Field-level encryption (bank details, TOTP secrets) ---
# 64 hex characters = 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key means losing the ciphertext. Rotating it must be deliberate.
ENCRYPTION_KEY=
