# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Database (Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5432/avenstrix_dev
# Used only by the integration/e2e suites. Must be a DISPOSABLE database.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/avenstrix_test

# --- First-run bootstrap ---
# The seed creates the CEO account ONLY when the user table is empty.
# Password must be at least 12 characters; the account is forced to change it on first login.
BOOTSTRAP_CEO_EMAIL=founder@avenstrixconsulting.com
BOOTSTRAP_CEO_NAME=Avinash Singh
BOOTSTRAP_CEO_PASSWORD=change-this-long-password

# --- Object storage (S3 / Cloudflare R2) for profile photos and contract PDFs ---
# The bucket MUST be private; files are served via short-lived presigned URLs.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- SMTP: used by POST /api/contact, and later by password reset ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
CONTACT_TO_EMAIL=hello@avenstrixconsulting.com
CONTACT_FROM_EMAIL=website@avenstrixconsulting.com

# --- Field-level encryption (bank details, TOTP secrets) ---
# 64 hex characters = 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key means losing the ciphertext. Rotating it must be deliberate.
ENCRYPTION_KEY=
